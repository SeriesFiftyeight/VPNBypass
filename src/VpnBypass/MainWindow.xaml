<Window x:Class="VpnBypass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:VpnBypass.Controls"
        x:Name="Self"
        Title="VPN Bypass" Width="420" Height="820" MinWidth="380" MaxWidth="560" MinHeight="660"
        WindowStartupLocation="CenterScreen" Icon="Assets/eye.ico"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Mono}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <DockPanel>
            <!-- ============ TITLE BAR ============ -->
            <Grid DockPanel.Dock="Top" Height="44">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="Assets/eye.ico" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Margin="10,0,0,0" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center">
                        <Run Text="VPN" /><Run Text=" BYPASS" Foreground="{StaticResource Neon}" />
                    </TextBlock>
                    <TextBlock Text="v2.1" Style="{StaticResource Label}" Margin="8,1,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource ChromeClose}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <!-- ============ CONNECT ============ -->
            <StackPanel DockPanel.Dock="Top" Margin="20,8,20,0">
                <Border x:Name="StatusPill" HorizontalAlignment="Center" CornerRadius="12" Padding="12,4" BorderThickness="1" BorderBrush="{StaticResource Red}" Background="{StaticResource RedSoft}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Red}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Red}" Text="{DynamicResource StatusOffline}" />
                    </StackPanel>
                </Border>

                <Grid Width="196" Height="196" Margin="0,22,0,0">
                    <Ellipse x:Name="Halo" Fill="{StaticResource Neon}" Opacity="0" Margin="10">
                        <Ellipse.Effect><BlurEffect Radius="40" /></Ellipse.Effect>
                    </Ellipse>
                    <Ellipse x:Name="Orbit" Stroke="{StaticResource Neon}" StrokeThickness="2" StrokeDashArray="18 12" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform x:Name="OrbitSpin" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Button x:Name="ConnectButton" Style="{StaticResource PowerButton}" Margin="16" Click="Connect_Click">
                        <StackPanel>
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="44" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ConnectLabel" Text="{DynamicResource BtnConnect}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock x:Name="StateText" HorizontalAlignment="Center" Margin="0,18,0,0" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="22" Text="{DynamicResource StateIdle}" />
                <TextBlock x:Name="StateSub" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" Style="{StaticResource Label}" FontSize="11" />
            </StackPanel>

            <!-- ============ STATS ============ -->
            <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="20,20,20,0">
                <Border Margin="0,0,4,0" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" FontSize="9.5" Text="{DynamicResource StatAvgPing}" />
                        <TextBlock x:Name="StatPing" FontSize="15" FontWeight="Bold" Margin="0,4,0,0" Text="···" />
                    </StackPanel>
                </Border>
                <Border Margin="4,0" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" FontSize="9.5" Text="{DynamicResource StatLoss}" />
                        <TextBlock x:Name="StatLoss" FontSize="15" FontWeight="Bold" Margin="0,4,0,0" Text="···" />
                    </StackPanel>
                </Border>
                <Border Margin="4,0,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" FontSize="9.5" Text="{DynamicResource StatTraffic}" />
                        <TextBlock x:Name="StatTraffic" FontSize="15" FontWeight="Bold" Margin="0,4,0,0" Text="0 KB" Foreground="{StaticResource Cyan}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ============ TABS ============ -->
            <Border DockPanel.Dock="Top" Margin="20,16,20,0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <UniformGrid Columns="4">
                    <RadioButton x:Name="TabPing" Style="{StaticResource Tab}" Content="{DynamicResource TabPing}" IsChecked="True" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabProfile" Style="{StaticResource Tab}" Content="{DynamicResource TabProfile}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabLog" Style="{StaticResource Tab}" Content="{DynamicResource TabLog}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabSettings" Style="{StaticResource Tab}" Content="{DynamicResource TabSettings}" Checked="Tab_Checked" />
                </UniformGrid>
            </Border>

            <Grid Margin="20,14,14,16">

                <!-- ============ PING ============ -->
                <DockPanel x:Name="PagePing">
                    <Grid DockPanel.Dock="Top" Margin="0,0,6,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="AvgLabel" Style="{StaticResource Label}" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel x:Name="Legend" Orientation="Horizontal" HorizontalAlignment="Right" />
                    </Grid>
                    <Border DockPanel.Dock="Top" Margin="0,0,6,8" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="4">
                        <c:Sparkline x:Name="AvgSpark" Height="56" ShowFill="True" Stroke="{StaticResource Neon}"
                                     GoodLimit="{Binding GoodLimit, ElementName=Self}" CriticalLimit="{Binding CriticalLimit, ElementName=Self}" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PingList" Margin="0,0,6,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="84" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Host}" Style="{StaticResource Label}" FontSize="9.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <c:Sparkline Grid.Column="1" Height="24" Margin="6,0,10,0" Values="{Binding History}" Stroke="{Binding Brush}"
                                                         GoodLimit="{Binding GoodLimit, RelativeSource={RelativeSource AncestorType=Window}}" CriticalLimit="{Binding CriticalLimit, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding MsText}" Foreground="{Binding Brush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding Label}" Foreground="{Binding Brush}" FontSize="9" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- ============ PROFILE ============ -->
                <ScrollViewer x:Name="PageProfile" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <Button x:Name="AutoFindButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" Padding="14,10" Content="{DynamicResource BtnAutoFind}" Click="AutoFind_Click" />
                        <TextBlock x:Name="AutoFindText" Style="{StaticResource Label}" FontSize="10.5" TextWrapping="Wrap" Margin="2,8,0,0" Visibility="Collapsed" />
                        <TextBlock Style="{StaticResource Section}" Text="{DynamicResource SecMethod}" />
                        <StackPanel x:Name="ProfileList" />
                        <TextBlock Style="{StaticResource Section}" Text="{DynamicResource SecDns}" />
                        <UniformGrid x:Name="DnsList" Columns="2" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ LOG ============ -->
                <DockPanel x:Name="PageLog" Visibility="Collapsed">
                    <Grid DockPanel.Dock="Top" Margin="0,0,6,6">
                        <TextBlock Text="root@vpnbypass:~$" Foreground="{StaticResource Neon}" FontSize="11" VerticalAlignment="Center" />
                        <Button Style="{StaticResource GhostButton}" Padding="10,3" FontSize="10" HorizontalAlignment="Right" Content="{DynamicResource BtnClear}" Click="ClearLog_Click" />
                    </Grid>
                    <ListBox x:Name="LogList" Style="{StaticResource LogList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="10.5" TextWrapping="Wrap">
                                    <Run Text="{Binding Time, Mode=OneWay}" Foreground="{StaticResource TextFaint}" />
                                    <Run Text="{Binding Tag, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}" FontWeight="Bold" />
                                    <Run Text="{Binding Text, Mode=OneWay}" Foreground="{StaticResource Text}" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- ============ SETTINGS ============ -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <CheckBox x:Name="OptAutoConnect" Style="{StaticResource Switch}" Content="{DynamicResource SetAutoConnect}" Click="Option_Click" />
                        <CheckBox x:Name="OptAutoStart" Style="{StaticResource Switch}" Content="{DynamicResource SetAutoStart}" Click="AutoStart_Click" />
                        <CheckBox x:Name="OptStartTray" Style="{StaticResource Switch}" Content="{DynamicResource SetStartTray}" Click="Option_Click" />
                        <CheckBox x:Name="OptCloseTray" Style="{StaticResource Switch}" Content="{DynamicResource SetCloseTray}" Click="Option_Click" />
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="{DynamicResource SetLanguage}" VerticalAlignment="Center" FontSize="12.5" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="LangTr" Style="{StaticResource GhostButton}" Content="TR" Padding="14,4" Click="Lang_Click" Tag="TR" />
                                <Button x:Name="LangEn" Style="{StaticResource GhostButton}" Content="EN" Padding="14,4" Margin="6,0,0,0" Click="Lang_Click" Tag="EN" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Section}" Text="{DynamicResource SetPing}" />
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource SetGoodMs}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Neon}" />
                            <TextBox x:Name="InGood" Style="{StaticResource TermBox}" Width="80" Height="30" Padding="8,0" VerticalContentAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource SetCritMs}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Red}" />
                            <TextBox x:Name="InCrit" Style="{StaticResource TermBox}" Width="80" Height="30" Padding="8,0" VerticalContentAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource SetInterval}" VerticalAlignment="Center" FontSize="12" />
                            <TextBox x:Name="InInterval" Style="{StaticResource TermBox}" Width="80" Height="30" Padding="8,0" VerticalContentAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" />
                        </Grid>
                        <CheckBox x:Name="OptAlert" Style="{StaticResource Switch}" Content="{DynamicResource SetAlert}" />
                        <TextBlock Text="{DynamicResource SetTargets}" Style="{StaticResource Label}" FontSize="10.5" Margin="0,8,0,6" />
                        <TextBox x:Name="InTargets" Style="{StaticResource TermBox}" Height="104" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" />
                        <Button Style="{StaticResource NeonButton}" Height="38" FontSize="12" Margin="0,12,0,0" Content="{DynamicResource BtnSave}" Click="SavePing_Click" />

                        <TextBlock Style="{StaticResource Section}" Text="{DynamicResource SetTools}" />
                        <Button Style="{StaticResource GhostButton}" Content="{DynamicResource BtnFlushDns}" HorizontalAlignment="Stretch" Click="FlushDns_Click" />
                        <Button Style="{StaticResource GhostButton}" Content="{DynamicResource BtnResetProxy}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Foreground="{StaticResource Amber}" Click="ResetProxy_Click" />

                        <TextBlock Style="{StaticResource Section}" Text="{DynamicResource SetAbout}" />
                        <TextBlock Text="{DynamicResource AboutText}" Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap" LineHeight="17" />
                        <TextBlock Text="© 2026 SeriesFiftyeight · MIT" Style="{StaticResource Label}" Margin="0,10,0,6" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" IsHitTestVisible="False" />
    </Grid>
</Window>
