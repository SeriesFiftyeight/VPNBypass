<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=System.Runtime">
    <s:String x:Key="StatusOnline">PROTECTED</s:String>
    <s:String x:Key="StatusOffline">UNPROTECTED</s:String>
    <s:String x:Key="BtnConnect">CONNECT</s:String>
    <s:String x:Key="BtnDisconnect">STOP</s:String>
    <s:String x:Key="StateActive">Connected</s:String>
    <s:String x:Key="StateIdle">Not connected</s:String>
    <s:String x:Key="StateBusy">Connecting...</s:String>

    <s:String x:Key="StatAvgPing">PING</s:String>
    <s:String x:Key="StatLoss">LOSS</s:String>
    <s:String x:Key="StatTraffic">TRAFFIC</s:String>

    <s:String x:Key="TabPing">PING</s:String>
    <s:String x:Key="TabProfile">PROFILE</s:String>
    <s:String x:Key="TabLog">LOG</s:String>
    <s:String x:Key="TabSettings">SETTINGS</s:String>

    <s:String x:Key="PingAverage">AVERAGE</s:String>
    <s:String x:Key="PingGood">GOOD</s:String>
    <s:String x:Key="PingWarn">FAIR</s:String>
    <s:String x:Key="PingBad">CRITICAL</s:String>
    <s:String x:Key="PingDown">DOWN</s:String>
    <s:String x:Key="PingNoIpv4">NO IPv4</s:String>
    <s:String x:Key="PingNoNet">NETWORK</s:String>

    <s:String x:Key="BtnAutoFind">⚡ AUTO-FIND THE BEST METHOD</s:String>
    <s:String x:Key="AutoFindRunning">Testing methods against blocked sites...</s:String>
    <s:String x:Key="AutoFindDone">Selected: {0} · {1} ({2}/{3} sites opened)</s:String>
    <s:String x:Key="AutoFindNoBlock">No blocking detected on this network. Lightest method selected: {0} · {1}</s:String>
    <s:String x:Key="AutoFindNone">No method got through. Check the log.</s:String>
    <s:String x:Key="AutoFindNoIpv4">Can't test: this PC has no IPv4 and the test sites are IPv4-only. Restart your router first.</s:String>
    <s:String x:Key="SecMethod">// METHOD</s:String>
    <s:String x:Key="SecDns">// ENCRYPTED DNS (DoH)</s:String>

    <s:String x:Key="BtnClear">CLEAR</s:String>

    <s:String x:Key="SetAutoConnect">Auto-connect on launch</s:String>
    <s:String x:Key="SetAutoStart">Start with Windows</s:String>
    <s:String x:Key="SetStartTray">Start hidden in tray</s:String>
    <s:String x:Key="SetCloseTray">Close button minimizes to tray</s:String>
    <s:String x:Key="SetLanguage">Language / Dil</s:String>
    <s:String x:Key="SetPing">// PING LIMITS</s:String>
    <s:String x:Key="SetGoodMs">Good threshold (ms)</s:String>
    <s:String x:Key="SetCritMs">Critical threshold (ms)</s:String>
    <s:String x:Key="SetInterval">Interval (sec)</s:String>
    <s:String x:Key="SetAlert">Notify on critical ping</s:String>
    <s:String x:Key="SetTargets">Targets · one "Name = host" per line</s:String>
    <s:String x:Key="BtnSave">SAVE</s:String>
    <s:String x:Key="SetTools">// TOOLS</s:String>
    <s:String x:Key="BtnFlushDns">FLUSH DNS CACHE</s:String>
    <s:String x:Key="BtnResetProxy">RESET PROXY SETTINGS</s:String>
    <s:String x:Key="SetAbout">// ABOUT</s:String>
    <s:String x:Key="AboutText">VPN Bypass runs its own engine: it resolves names over encrypted DNS and reshapes each connection's first packet to slip past DPI filters. Your traffic never goes through another server, and no driver or admin rights are needed.</s:String>

    <s:String x:Key="Saved">settings saved</s:String>
    <s:String x:Key="TrayShow">Open panel</s:String>
    <s:String x:Key="TrayConnect">Connect</s:String>
    <s:String x:Key="TrayDisconnect">Disconnect</s:String>
    <s:String x:Key="TrayExit">Exit</s:String>
    <s:String x:Key="TrayHidden">Running in background. Double-click the icon to open.</s:String>
    <s:String x:Key="HighPingAlert">High ping: {0} ms (limit {1} ms)</s:String>
    <s:String x:Key="EngineFail">Engine failed to start. See the log for details.</s:String>
    <s:String x:Key="Ipv4Lost">No IPv4 connectivity: the network adapter got no address from the router (169.254.x.x). Reconnect Wi-Fi, run ipconfig /renew or restart the router.</s:String>
    <s:String x:Key="Ipv4Back">IPv4 connectivity restored</s:String>
</ResourceDictionary>
